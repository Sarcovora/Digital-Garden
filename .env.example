# Copy to .env and edit. Nothing here is a secret except the deploy key file it points to.

# Where the web container listens. Keep the 127.0.0.1: prefix and put Tailscale Serve (or another private proxy) in front.
HTTP_PORT=127.0.0.1:8093

# A git checkout of your vault (the sync container pulls into it).
VAULT_PATH=/path/to/your/vault
# Build output, status and the SSH known_hosts file live here.
DATA_PATH=./data
# A read-only deploy key for the vault's repository (private key file).
DEPLOY_KEY_PATH=/path/to/deploy_key

# The sync container runs as this uid/gid so it can write to VAULT_PATH and DATA_PATH. Use `id -u` and `id -g`.
GARDEN_UID=1000
GARDEN_GID=1000

# Optional: Quartz parse threads for a build (default 12).
# BUILD_THREADS=12
